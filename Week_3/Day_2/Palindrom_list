class Solution {
    public boolean isPalindrome(ListNode head) {
        ListNode temp = head;
        ListNode temp2 = head;
        while(temp2 != null && temp2.next != null ){
            temp = temp.next;
            temp2 = temp2.next.next;
        }
        ListNode prev = null;
        ListNode current = temp;
        while(current != null){
            ListNode newNode = current.next;
            current.next = prev;
            prev = current;
            current = newNode;
            
        }
        ListNode first = head;
        ListNode second = prev;
        while(second != null){
            if(first.val != second.val){
                return false;
            }
        first = first.next;
        second = second.next;
        }
        return true;
    }
}