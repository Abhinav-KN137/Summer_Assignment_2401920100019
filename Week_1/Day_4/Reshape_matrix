class Solution {
    public int[][] matrixReshape(int[][] mat, int r, int c) {
        int m = mat.length;
        int n = mat[0].length;
        if(m*n != r*c){
            return mat;
        }
        int [][] result = new int[r][c];
        int a=0;
        int b=0;
        for(int i = 0; i < m ; i++){
            for(int j =0 ; j < n ; j++){
                result[a][b] = mat[i][j];
                b++; 
                if(b == c){
                    b=0;
                    a++;
                }
            }
        }
        return result;
    }
}